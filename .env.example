# Copy to .env and fill in. NEVER commit .env. NEVER bake it into images.
# Pass secrets at runtime: `docker run -e PINECONE_API_KEY=...`

# --- Runtime ---
FLASK_ENV=development            # development | test | production
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_SECRET_KEY=                # REQUIRED in production (long random hex)
LOG_LEVEL=INFO

# --- Providers ---
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
PINECONE_API_KEY=
OPENAI_API_KEY=                  # required only for /analyze-image

# --- Request limits (defaults documented in src/config.py) ---
# MAX_REQUEST_BYTES=8388608
# CHAT_MSG_MAX_CHARS=2000
# RATE_CHAT_PER_MIN=20 per minute
# RATE_CHAT_THREAD_PER_MIN=30 per minute
# RATE_IMAGE_PER_MIN=6 per minute

# --- Image limits ---
# MAX_IMAGE_BYTES=5242880
# IMG_MAX_DIM=4096
# IMG_MAX_PIXELS=16777216
# IMG_PROVIDER_LONG_SIDE=1600
# VISION_TIMEOUT_S=60

# --- RAG evidence quality (P1.2; calibrated: relevant +5, unrelated -11) ---
# RERANK_THRESHOLD=0.0

# --- Chunking (P1.14; changing these requires re-running store_index.py) ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150

# --- Generation + reformulation bounds (P1.6/P1.8) ---
# GEN_MAX_MESSAGES=8
# REFORM_MAX_TURNS=3
# REFORM_MAX_CHARS=1500

# --- Thread memory bounds (P1.7/P1.8) ---
# THREAD_MAX_TURNS=30
# THREAD_MAX_CHARS=20000
# THREAD_TTL_S=7200

# --- Corpus manifest (P1.12/P1.13; written by store_index.py) ---
# INDEX_MANIFEST=data/index_manifest.json
